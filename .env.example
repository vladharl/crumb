# ─────────────────────────────────────────────────────────────
# Crumb — Docker Compose / production deploy environment.
# Copy to `.env` (gitignored) next to docker-compose.yml and fill in.
# Compose reads this for both ${VAR} interpolation and the dashboard env.
# (For local `pnpm dev` instead, see apps/dashboard/.env.local.example.)
# ─────────────────────────────────────────────────────────────

# ── Database (runs as the `postgres` service) ──────────────────
POSTGRES_USER=crumb
POSTGRES_PASSWORD=change-me-to-a-long-random-string   # REQUIRED: change for production
POSTGRES_DB=crumb
# Host port binding. Default 127.0.0.1 keeps Postgres off the public internet;
# the dashboard reaches it internally regardless. Leave as-is on a VPS.
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5432

# ── Build edition (community = self-host; excludes Stripe/AI/replay) ──
CRUMB_EDITION=community

# ── Runtime ────────────────────────────────────────────────────
CRUMB_TIER=self_host
# The public URL your tunnel/DNS serves. REQUIRED for OAuth integrations —
# must exactly match the redirect URLs you register in each provider.
CRUMB_APP_URL=https://crumb.localhostlabs.net
CRUMB_WORKSPACE_SLUG=northbeam
# Dashboard host port. Default 127.0.0.1 (private; the tunnel reaches it over
# the internal network). Set DASHBOARD_BIND=0.0.0.0 only to expose directly.
# DASHBOARD_BIND=127.0.0.1
# DASHBOARD_PORT=3000

# ── Encrypt integration tokens at rest (recommended) ───────────
# Generate: openssl rand -hex 32
CRUMB_ENCRYPTION_KEY=
CRUMB_ENCRYPTION_KEY_ID=1

# ── Cloudflare Tunnel (only used with `--profile tunnel`) ──────
# Create a tunnel in the Cloudflare Zero Trust dashboard, route a public
# hostname (crumb.localhostlabs.net → http://dashboard:3000), copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Maintenance cron (orphan sweep endpoint; 503s until set) ───
# Generate: openssl rand -hex 32
CRUMB_INTERNAL_SWEEP_SECRET=

# ── Integrations: bring your own OAuth-app creds (see DEPLOY.md) ──
# Each provider's redirect/callback URL is:
#   ${CRUMB_APP_URL}/api/integrations/<provider>/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Email (optional) ───────────────────────────────────────────
# SMTP relay (works on self-host). Leave unset to log magic links to stdout.
CRUMB_EMAIL_PROVIDER=
CRUMB_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Resend (requires CRUMB_TIER=cloud):
RESEND_API_KEY=
