# ─────────────────────────────────────────────────────────────
# Crumb — Docker Compose / production deploy environment.
# Copy to `.env` (gitignored) next to docker-compose.yml and fill in.
# Compose uses it for ${VAR} interpolation and passes every variable in it to
# the dashboard container (`env_file` in docker-compose.yml), so any setting
# documented in apps/dashboard/.env.local.example (rate limits, logging, AI
# caps, CRM options, redirect overrides, key rotation, ...) works when added
# here. Add optional settings with a value or not at all: an empty value makes
# a few numeric knobs misbehave instead of falling back to their default.
# (For local `pnpm dev`, use apps/dashboard/.env.local instead.)
# ─────────────────────────────────────────────────────────────

# ── Database (runs as the `postgres` service) ──────────────────
POSTGRES_USER=crumb
POSTGRES_PASSWORD=change-me-to-a-long-random-string   # REQUIRED: change for production
POSTGRES_DB=crumb
# Host port binding. Default 127.0.0.1 keeps Postgres off the public internet;
# the dashboard reaches it internally regardless. Leave as-is on a VPS.
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5432

# ── Build edition (community = self-host; excludes Stripe/AI/replay) ──
CRUMB_EDITION=community

# ── Runtime ────────────────────────────────────────────────────
CRUMB_TIER=self_host
# The public URL your tunnel/DNS serves (replace with your domain). REQUIRED
# for sign-in links and OAuth integrations: it must exactly match the redirect
# URLs you register in each provider.
CRUMB_APP_URL=https://crumb.example.com
# Dashboard host port. Default 127.0.0.1 (private; the tunnel reaches it over
# the internal network). Set DASHBOARD_BIND=0.0.0.0 only to expose directly.
# DASHBOARD_BIND=127.0.0.1
# DASHBOARD_PORT=3000

# ── Encrypt integration tokens at rest (recommended) ───────────
# Generate: openssl rand -hex 32
# Set it after integrations were already connected? The command below encrypts
# every integration secret already stored: Slack, Linear, Jira, HubSpot,
# Salesforce, Teams, customers' channel webhooks and feedback connectors.
#   docker compose exec dashboard node packages/db/dist/backfill-encrypt-secrets.mjs
# Key rotation: see apps/dashboard/.env.local.example.
CRUMB_ENCRYPTION_KEY=
CRUMB_ENCRYPTION_KEY_ID=1

# ── File storage (attachments, Cloud session replays) ──────────
# docker-compose.yml defaults this to postgres: files live in the database, so
# they survive container recreates and every pg_dump includes them. "local"
# writes inside the container and loses files on every upgrade unless
# CRUMB_STORAGE_DIR points at a mounted volume.
# CRUMB_STORAGE_PROVIDER=postgres

# ── Cloudflare Tunnel (only used with `--profile tunnel`) ──────
# Create a tunnel in the Cloudflare Zero Trust dashboard, route a public
# hostname (crumb.example.com → http://dashboard:3000), copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Maintenance cron (internal endpoints; each 503s until set) ─
# Shared secret for /api/v1/internal/replay-sweep, crm-sync and feedback-sync.
# DEPLOY.md has crontab lines that read it from this file.
# Generate: openssl rand -hex 32
# The replay sweep also prunes aged usage-analytics events (see below).
CRUMB_INTERNAL_SWEEP_SECRET=
# It also deletes session replays older than this many days. Default 30;
# 0 keeps replays forever. Per-plan overrides (_FREE / _TEAM / _GROWTH) win.
# CRUMB_REPLAY_RETENTION_DAYS=30
# CRUMB_REPLAY_RETENTION_DAYS_GROWTH=90

# ── Usage analytics (optional caps; sensible defaults apply) ───
# Monthly per-workspace usage_events ingestion cap (Cloud metering only;
# self-host is unmetered). Overrides the per-plan default.
# CRUMB_USAGE_EVENTS_MONTHLY_CAP=2000000
# How long usage_events are retained before the maintenance sweep drops them.
# Default 180 days. Aggregations only look back ≤90d, so this never affects a
# live surface.
# CRUMB_USAGE_EVENTS_RETENTION_DAYS=180

# ── Inbound email (optional): reply-by-email + forward-to-capture ──
# Domain your mail provider routes to /api/v1/inbound/* (Resend Inbound /
# SendGrid Parse / Mailgun). Customers reply to notification emails (lands on
# the thread); forward a customer email to inbox+<slug>.<token>@DOMAIN → a
# pending capture in /captures. The secret signs the addresses + gates the
# webhook. Generate: openssl rand -hex 32.
CRUMB_INBOUND_DOMAIN=
CRUMB_INBOUND_SECRET=

# ── Integrations: bring your own OAuth-app creds (see DEPLOY.md) ──
# Each provider's redirect/callback URL is:
#   ${CRUMB_APP_URL}/api/integrations/<provider>/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies the /crumb slash command + interactivity requests (Slack inbound).
SLACK_SIGNING_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The GitHub App's client ID + a client secret, with "Request user
# authorization (OAuth) during installation" turned on in the App settings.
# Crumb then checks the person installing can access the installation.
# Required on Cloud: without them no installation binds. On self-host, without
# them Crumb only accepts an installation created or updated in the last 10
# minutes.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# CRM sync (optional) — pull accounts + ARR one-way from HubSpot / Salesforce.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Admins pick the field that holds ARR after connecting. On self-host this
# presets HubSpot's: a custom property with what each company pays you, not
# annualrevenue (that is the company's own revenue).
# HUBSPOT_ARR_PROPERTY=arr
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://test.salesforce.com   # sandbox or My Domain login host

# ── Email (optional) ───────────────────────────────────────────
# SMTP relay (works on self-host). Leave unset to log magic links to stdout.
CRUMB_EMAIL_PROVIDER=
CRUMB_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # with SMTP_PORT=465 (TLS from the first byte)
SMTP_USER=
SMTP_PASS=
# Resend (requires CRUMB_TIER=cloud). Self-serve signup needs a real provider
# (resend or smtp) so confirmation emails actually deliver — stdout won't do.
RESEND_API_KEY=
# Emails started per second, shared by everything Crumb sends (digests, alerts,
# announcements). Blank means 2, Resend's default limit; raise it to match the
# limit your provider gives you.
CRUMB_EMAIL_SENDS_PER_SEC=
# Operator address notified whenever someone completes self-serve signup.
# Leave unset to disable the notification. Needs a real email provider above.
CRUMB_OPS_EMAIL=
# Where in-app Help → Contact messages are delivered. Falls back to
# CRUMB_OPS_EMAIL when unset; if neither is set (or no real email provider is
# configured) the in-app contact form is hidden.
CRUMB_SUPPORT_EMAIL=

# ── Cloud billing (Stripe; requires CRUMB_TIER=cloud) ──────────
# We're the merchant of record (Stripe-direct). Create one product with four
# prices and set each price's lookup_key to: team_monthly, team_annual,
# growth_monthly, growth_annual. The webhook keys plan_id off the prefix
# (team/growth). Enable Stripe Tax for VAT/sales-tax. Webhook endpoint:
#   ${CRUMB_APP_URL}/api/v1/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — where the Stripe billing portal returns to (defaults to /settings/billing).
STRIPE_PORTAL_RETURN_URL=

# ── Self-serve signup abuse protection (Cloudflare Turnstile) ──
# Optional but recommended for the public /signup form. Both are read at
# runtime (no rebuild needed). When the secret is unset, Turnstile is treated
# as not-enforced (fine for dev/self-host, which has no /signup).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
