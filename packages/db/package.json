{
  "name": "@crumb/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "push": "drizzle-kit push",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "build:migrate": "esbuild src/migrate.runtime.js --bundle --platform=node --target=node20 --format=esm --packages=bundle --outfile=dist/migrate.mjs",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
