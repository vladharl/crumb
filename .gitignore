# Cloud-only ("ee") route overlay. Canonical source lives in
# apps/dashboard/ee/app/**; these mirrored paths are generated by
# scripts/apply-ee.mjs for cloud/dev builds and must never be committed
# (the community build ships without them, so they 404 on self-host).
apps/dashboard/app/api/v1/stripe/webhook/
apps/dashboard/app/api/v1/replay-sessions/
apps/dashboard/app/api/v1/ask/
apps/dashboard/app/(app)/settings/billing/
# Local file-storage backend (replay chunks, attachments) — the default
# CRUMB_STORAGE_DIR when CRUMB_STORAGE_PROVIDER=local (dev / single-instance).
apps/dashboard/.crumb-uploads/
# Playwright MCP scratch (snapshots, console logs, screenshots).
.playwright-mcp/
