{
  "name": "@crumb/widget",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/widget.ts --bundle --minify --format=iife --target=es2018 --outfile=../dashboard/public/widget.js && esbuild src/widget-record.ts --bundle --minify --format=iife --target=es2018 --outfile=../dashboard/public/widget-record.js",
    "dev": "esbuild src/widget.ts --bundle --format=iife --target=es2018 --sourcemap --watch --outfile=../dashboard/public/widget.js",
    "build:record": "esbuild src/widget-record.ts --bundle --minify --format=iife --target=es2018 --outfile=../dashboard/public/widget-record.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "motion": "^11.18.2",
    "rrweb": "2.0.0-alpha.20"
  }
}
